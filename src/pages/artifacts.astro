</style>

<script>
  const root = document.querySelector('[data-filter-root]');
  const chips = root?.querySelectorAll<HTMLButtonElement>('[data-filter-cat]') ?? [];
  const cats = Array.from(document.querySelectorAll<HTMLElement>('.cat'));

  function applyFilter(cat: string) {
    for (const c of cats) {
      c.style.display = cat === 'all' || c.dataset.cat === cat ? '' : 'none';
    }
    for (const chip of chips) {
      chip.setAttribute('aria-pressed', chip.dataset.filterCat === cat ? 'true' : 'false');
    }
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => applyFilter(chip.dataset.filterCat!));
  }
</script>
