---
import BaseLayout from '../layouts/BaseLayout.astro';

// ── Windows artifacts I've actually had my hands on. ───────────────────────
// The standalone reference deck the AI drafted carried 22 artifacts across 6
// categories — including a few it claimed I'd "seen" in labs I never touched
// (Hunter, DumpMe). This page keeps only what my own CyberDefenders / THM work
// actually put in front of me, and says how sure I am of each:
//
//   confirmed — a challenge exercised it and I can point at the receipt
//               (a listed parser, or an artifact I demonstrably had to parse)
//   likely    — I did the challenge and its objective all but requires it,
//               but I can't anchor it to a single line on the challenge page
//
// Everything the deck had that I haven't genuinely needed yet is parked at the
// bottom, named honestly, ready to pull back up the moment a case calls for it.
// Scope: Windows disk/endpoint only — memory & mobile live elsewhere.

type Cat = 'exec' | 'persist' | 'files' | 'account' | 'ntfs';
type Status = 'confirmed' | 'likely';
type Diff = 'medium' | 'hard' | 'in progress';

type Seen = {
  name: string;
  platform: 'CD' | 'THM';
  difficulty: Diff;
  url?: string;        // omitted where there's no public receipt yet (WIP)
  via?: string;        // the tool/parser or note that ties me to this artifact
};

type Artifact = {
  cat: Cat;
  name: string;
  status: Status;
  source: string;
  proves: string;
  path: string;
  parsers: string[];
  fields: { k: string; v: string }[];
  seen: Seen[];
};

const CATS: { id: Cat; label: string; blurb: string }[] = [
  { id: 'exec',    label: 'PROGRAM EXECUTION',  blurb: 'what ran, when, how often' },
  { id: 'persist', label: 'PERSISTENCE',        blurb: 'how it survives a reboot' },
  { id: 'files',   label: 'FILE & FOLDER ACCESS', blurb: 'what was opened & browsed' },
  { id: 'account', label: 'ACCOUNT & LOGON',    blurb: 'who authenticated, and how' },
  { id: 'ntfs',    label: 'FILESYSTEM / NTFS',  blurb: 'the ground truth underneath' }
];

// Real receipts. SpottedInTheWild is earned (linkable); Recruiter — Hanoi Op is
// still in progress (7/22), so it has no achievement URL yet.
const SPOTTED: Seen = { name: 'SpottedInTheWild', platform: 'CD', difficulty: 'hard', url: 'https://cyberdefenders.org/blueteam-ctf-challenges/achievements/nils.hillmann/spottedinthewild/' };
const RECRUITER = (via: string): Seen => ({ name: 'Recruiter — Hanoi Op', platform: 'CD', difficulty: 'in progress', via });
const WINFOR2: Seen = { name: 'Windows Forensics 2', platform: 'THM', difficulty: 'medium', url: 'https://tryhackme.com/room/windowsforensics2' };
const WINFOR1: Seen = { name: 'Windows Forensics 1', platform: 'THM', difficulty: 'medium', url: 'https://tryhackme.com/room/windowsforensics1' };

const ARTIFACTS: Artifact[] = [
  // ── PROGRAM EXECUTION ──
  {
    cat: 'exec', name: 'Prefetch', status: 'confirmed', source: '.pf files',
    proves: 'That a program actually ran, plus run count and the last up-to-8 run timestamps. The cleanest single "it executed" artifact.',
    path: 'C:\\Windows\\Prefetch\\*.pf',
    parsers: ['PECmd (EZ)', 'WinPrefetchView'],
    fields: [
      { k: 'Executable name', v: 'binary that ran (+ path hash in filename)' },
      { k: 'Run count', v: 'how many times it executed' },
      { k: 'Last 8 run times', v: 'timestamps of the most recent executions' },
      { k: 'Loaded files/dirs', v: 'resources the process touched at start' }
    ],
    seen: [RECRUITER('PECmd — listed on the challenge'), WINFOR1]
  },
  {
    cat: 'exec', name: 'AmCache', status: 'confirmed', source: 'SOFTWARE-style hive',
    proves: 'Presence and first-execution-ish evidence of executables, with SHA-1 hashes — great for pivoting on known-bad binaries.',
    path: 'C:\\Windows\\AppCompat\\Programs\\Amcache.hve',
    parsers: ['AmcacheParser (EZ)', 'RegRipper'],
    fields: [
      { k: 'File path + name', v: 'full path of the executable as seen on disk' },
      { k: 'SHA-1 hash', v: 'pivot on known-bad / VirusTotal without the binary' },
      { k: 'Link date', v: 'PE compilation time (identity, not execution)' },
      { k: 'First-seen time', v: 'when the OS first inventoried the file' }
    ],
    seen: [RECRUITER('needed it for the SHA-1 pivot — not on the tool list, but the case demanded it')]
  },
  {
    cat: 'exec', name: 'ShimCache (AppCompatCache)', status: 'likely', source: 'SYSTEM hive',
    proves: 'That an executable existed at a path, plus its $StandardInfo modified time. A presence indicator across reboots.',
    path: 'SYSTEM\\CurrentControlSet\\Control\\Session Manager\\AppCompatCache',
    parsers: ['AppCompatCacheParser (EZ)', 'RegRipper'],
    fields: [
      { k: 'File path', v: 'full path the OS registered the binary at' },
      { k: '$SI modified time', v: "file's last-modified timestamp at cache time" },
      { k: 'Cache position', v: 'rough LIFO order — newer entries near the top' }
    ],
    seen: [RECRUITER('execution stage, Registry Explorer'), WINFOR2]
  },
  {
    cat: 'exec', name: 'UserAssist', status: 'likely', source: 'NTUSER.DAT hive',
    proves: 'GUI-launched programs per user, with run count and last-run time. Per-user, so it ties execution to an account.',
    path: 'NTUSER.DAT\\...\\Explorer\\UserAssist\\{GUID}\\Count',
    parsers: ['RegRipper', 'RECmd (EZ)'],
    fields: [
      { k: 'Program', v: 'GUI-launched app (value name is ROT13-encoded)' },
      { k: 'Run count', v: 'launches via Explorer / Start menu' },
      { k: 'Last-run time', v: 'most recent execution for this user' },
      { k: 'Focus time', v: 'how long the window was in focus' }
    ],
    seen: [RECRUITER('execution stage'), WINFOR2]
  },

  // ── PERSISTENCE ──
  {
    cat: 'persist', name: 'Run / RunOnce Keys', status: 'likely', source: 'SOFTWARE + NTUSER.DAT',
    proves: 'Programs set to auto-start at logon — the first place to look for cheap, classic persistence.',
    path: '...\\Microsoft\\Windows\\CurrentVersion\\Run  (HKLM & HKCU)',
    parsers: ['RegRipper', 'RECmd (EZ)', 'Autoruns'],
    fields: [
      { k: 'Value name', v: 'label of the autostart entry' },
      { k: 'Command / path', v: 'binary or script launched at logon' },
      { k: 'Hive scope', v: 'HKLM (all users) vs HKCU (per user)' },
      { k: 'Key last-write', v: 'when the autostart was last modified' }
    ],
    seen: [RECRUITER('persistence stage, Registry Explorer'), WINFOR2]
  },
  {
    cat: 'persist', name: 'Services', status: 'likely', source: 'SYSTEM hive',
    proves: 'Installed services and their binaries / start type — a favourite for SYSTEM-level persistence and lateral movement.',
    path: 'SYSTEM\\CurrentControlSet\\Services\\{name}',
    parsers: ['RegRipper', 'RECmd (EZ)'],
    fields: [
      { k: 'Service name', v: 'internal + display name' },
      { k: 'ImagePath', v: 'binary / command the service runs' },
      { k: 'Start type', v: 'boot / auto / manual / disabled' },
      { k: 'Key last-write', v: 'when the service was last configured' }
    ],
    seen: [RECRUITER('persistence stage')]
  },

  // ── ACCOUNT & LOGON ──
  {
    cat: 'account', name: 'Logon Events', status: 'confirmed', source: 'Security.evtx',
    proves: 'Interactive, network, and RDP logons (4624), failures (4625), and the logon type that tells you how they got in.',
    path: 'C:\\Windows\\System32\\winevt\\Logs\\Security.evtx',
    parsers: ['EvtxECmd (EZ)', 'Event Log Explorer', 'Chainsaw'],
    fields: [
      { k: 'Event ID', v: '4624 success / 4625 fail / 4634 logoff' },
      { k: 'Logon type', v: '2 interactive · 3 network · 10 RDP' },
      { k: 'Account + domain', v: 'who authenticated' },
      { k: 'Source IP / host', v: 'where the logon came from' }
    ],
    seen: [{ ...SPOTTED, via: 'Event Log Explorer — listed on the challenge' }, RECRUITER('EvtxECmd — listed on the challenge')]
  },
  {
    cat: 'account', name: 'SAM Accounts', status: 'confirmed', source: 'SAM hive',
    proves: 'Local accounts: username, RID, last login, login count, group membership, and account-creation time.',
    path: 'C:\\Windows\\System32\\config\\SAM',
    parsers: ['RegRipper', 'RECmd (EZ)'],
    fields: [
      { k: 'Username + RID', v: 'account name and relative ID' },
      { k: 'Last login time', v: 'most recent successful logon (UTC)' },
      { k: 'Login count', v: 'total interactive logons' },
      { k: 'Created / groups', v: 'account creation time + membership' }
    ],
    seen: [RECRUITER('worked it in the credential-access stage')]
  },

  // ── FILESYSTEM / NTFS ──
  {
    cat: 'ntfs', name: 'NTFS Metadata Files', status: 'confirmed', source: '$-prefixed system files',
    proves: "The filesystem's own records: every file's existence, timestamps, size, and a change history — the ground truth other artifacts sit on top of.",
    path: 'Volume root (hidden system files, e.g. C:\\$MFT)',
    parsers: ['MFTECmd (EZ)', 'NTFS Log Tracker', 'analyzeMFT'],
    fields: [
      { k: '$MFT', v: 'one record per file: name, path, size, MAC times' },
      { k: '$LogFile', v: 'recent transactions — recover just-deleted entries' },
      { k: '$UsnJrnl', v: 'change journal: create/rename/delete history' },
      { k: '$SI vs $FN times', v: 'compare to catch timestomping' }
    ],
    seen: [{ ...SPOTTED, via: 'NTFS Log Tracker — listed on the challenge' }, RECRUITER('MFTECmd — listed on the challenge')]
  }
];

// Parked: what the deck carried that I haven't genuinely needed in a lab yet.
// Named honestly so I can pull any of them up the second a case calls for it.
const PARKED: { name: string; why: string }[] = [
  { name: 'Services',             why: 'service-based persistence — not touched in a lab yet' },
  { name: 'Scheduled Tasks',      why: 'trigger-based persistence — not touched in a lab yet' },
  { name: 'ShellBags',            why: 'browsed-folder history — know it, no case has needed it yet' },
  { name: 'Jump Lists',           why: 'per-app recent files — not needed in a lab yet' },
  { name: 'BAM / DAM',            why: 'per-SID last-run — no lab has hinged on it yet' },
  { name: 'SRUM',                 why: 'resource/network history — not touched yet' },
  { name: 'WMI Event Subscriptions', why: 'fileless persistence — beyond my labs so far' },
  { name: 'LNK & Recent Files',   why: "haven't had to parse shortcuts in a case yet" },
  { name: 'Recycle Bin',          why: 'no deleted-file recovery lab yet' },
  { name: 'Timezone & System Config', why: 'context I read inline, never the objective' },
  { name: 'USBSTOR & device history', why: 'no USB-centric case on the record yet' }
];

// ── Derived ────────────────────────────────────────────────────────────────
const catSections = CATS.map(c => ({
  ...c,
  items: ARTIFACTS.filter(a => a.cat === c.id)
})).filter(s => s.items.length > 0);

const confirmed = ARTIFACTS.filter(a => a.status === 'confirmed').length;
const stats = [
  { n: ARTIFACTS.length, label: 'ON THE BENCH' },
  { n: confirmed,        label: 'CONFIRMED' },
  { n: ARTIFACTS.length - confirmed, label: 'LIKELY' },
  { n: PARKED.length,    label: 'PARKED' }
];

const FILTERS = [
  { id: 'all', label: 'ALL', count: ARTIFACTS.length },
  ...CATS.filter(c => ARTIFACTS.some(a => a.cat === c.id)).map(c => ({
    id: c.id, label: c.label, count: ARTIFACTS.filter(a => a.cat === c.id).length
  }))
];

function seenTitle(s: Seen): string {
  const provider = s.platform === 'CD' ? 'CyberDefenders' : 'TryHackMe';
  const diff = s.difficulty === 'in progress' ? 'in progress' : s.difficulty;
  const base = `${s.name} — ${provider} (${diff})`;
  return s.via ? `${base} · ${s.via}` : base;
}
function seenDiffClass(d: Diff): string {
  return d === 'hard' ? 'd-hard' : 'd-med';
}
---
<BaseLayout title="Windows Artifacts — dfir.89deg.com">

  <section class="page-head container">
    <p class="kicker">// ARTIFACTS — WINDOWS</p>
    <h1>What the disk remembers, and what it doesn&rsquo;t.</h1>
    <p class="lede">A working reference to the Windows artifacts I&rsquo;ve actually parsed — cut down from an AI-drafted deck to only what my own labs put in front of me. Each card says how sure I am, and links back to the challenge that made me touch it.</p>

    <div class="legend">
      <span class="lg-label">STATUS:</span>
      <span><span class="dot s-confirmed"></span> confirmed — a receipt backs it</span>
      <span><span class="dot s-likely"></span> likely — did the lab, no line-item proof</span>
    </div>

    <div class="stats">
      {stats.map(s => (
        <div class="stat">
          <span class="stat-n">{s.n}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="container filter-section" data-filter-root>
    <div class="filter-bar">
      {FILTERS.map(f => (
        <button
          type="button"
          class="filter-chip"
          data-filter-cat={f.id}
          aria-pressed={f.id === 'all' ? 'true' : 'false'}
        >{f.label} <span class="chip-count">({f.count})</span></button>
      ))}
    </div>
  </section>

  <section class="container cards-section">
    {catSections.map(sec => (
      <div class="cat" data-cat={sec.id}>
        <div class="cat-head">
          <h2>{sec.label}</h2>
          <span class="cat-blurb">{sec.blurb}</span>
        </div>
        <div class="grid">
          {sec.items.map(a => (
            <article class={`card status-${a.status}`}>
              <header class="card-head">
                <h3>{a.name}</h3>
                <span class={`badge s-${a.status}`}>{a.status}</span>
              </header>
              <p class="source">{a.source}</p>
              <p class="proves">{a.proves}</p>

              <p class="path"><span class="path-label">PATH</span> {a.path}</p>

              <div class="fields">
                {a.fields.map(f => (
                  <div class="field">
                    <span class="f-k">{f.k}</span>
                    <span class="f-v">{f.v}</span>
                  </div>
                ))}
              </div>

              <div class="parsers">
                <span class="p-label">PARSERS</span>
                {a.parsers.map(p => <span class="parser">{p}</span>)}
              </div>

              <div class="seen">
                <span class="seen-label">SEEN IN</span>
                <div class="seen-list">
                  {a.seen.map(s => (
                    s.url ? (
                      <a href={s.url} target="_blank" rel="noopener" class="receipt" title={seenTitle(s)}>
                        <span class={`diff ${seenDiffClass(s.difficulty)}`}>{s.difficulty === 'in progress' ? 'wip' : s.difficulty}</span>
                        {s.name}
                      </a>
                    ) : (
                      <span class="receipt no-link" title={seenTitle(s)}>
                        <span class={`diff ${seenDiffClass(s.difficulty)}`}>{s.difficulty === 'in progress' ? 'wip' : s.difficulty}</span>
                        {s.name}
                      </span>
                    )
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section class="container parked-section">
    <div class="parked-head">
      <h2>PARKED</h2>
      <span class="parked-note">the deck had these — I just haven&rsquo;t needed them yet, and I&rsquo;ll say so</span>
    </div>
    <div class="parked-grid">
      {PARKED.map(p => (
        <div class="parked-card">
          <span class="parked-name">{p.name}</span>
          <span class="parked-why">{p.why}</span>
        </div>
      ))}
    </div>
  </section>

  <p class="tail container">Status is my own honest call, not the platform&rsquo;s. &ldquo;Confirmed&rdquo; means the challenge listed the parser or the objective forced the artifact; &ldquo;likely&rdquo; means I did the challenge and its goal all but requires it. Receipts link straight to the room or lab — check any of them.</p>

</BaseLayout>

<style>
  .page-head { padding-top: 72px; }
  h1 {
    margin: 0;
    font-size: clamp(34px, 7.5vw, 56px);
    line-height: 1.08;
    font-weight: 500;
    letter-spacing: -0.015em;
    max-width: 18ch;
    text-wrap: balance;
  }
  .lede {
    margin: 22px 0 0 0;
    font-size: 20px;
    line-height: 1.55;
    color: var(--dim);
    font-style: italic;
    max-width: 60ch;
    text-wrap: pretty;
  }

  /* legend */
  .legend {
    margin-top: 32px;
    border: 1px solid var(--hairline);
    background: var(--soft);
    padding: 14px 20px;
    display: flex;
    gap: 10px 26px;
    flex-wrap: wrap;
    align-items: center;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--muted);
  }
  .lg-label { color: var(--faint); }
  .dot {
    display: inline-block;
    width: 9px; height: 9px;
    border-radius: 50%;
    margin-right: 7px;
    vertical-align: middle;
  }
  .s-confirmed { background: var(--accent); }
  .s-likely { background: var(--faint); }

  /* stats */
  .stats {
    margin-top: 22px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--hairline);
    background: var(--soft);
  }
  .stat {
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    border-right: 1px solid var(--hairline);
  }
  .stat:last-child { border-right: none; }
  .stat-n {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 32px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1;
  }
  .stat-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: var(--faint);
  }

  /* filters */
  .filter-section { padding-top: 36px; }
  .filter-bar { display: flex; flex-wrap: wrap; gap: 8px; }
  .filter-chip {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    background: transparent;
    color: var(--muted);
    border: 1px solid var(--hairline);
    padding: 6px 13px;
    cursor: pointer;
  }
  .filter-chip:hover { border-color: var(--accent-bd); color: var(--accent); }
  .filter-chip[aria-pressed='true'] {
    background: var(--soft);
    color: var(--accent);
    border-color: var(--accent);
  }
  .chip-count { opacity: 0.6; }

  /* category sections */
  .cards-section { padding-top: 20px; }
  .cat { padding-top: 44px; }
  .cat-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 12px;
  }
  .cat-head h2 {
    margin: 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }
  .cat-blurb {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: var(--faint);
  }

  /* cards */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 16px;
    padding-top: 22px;
  }
  .card {
    border: 1px solid var(--hairline);
    background: var(--card);
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .card.status-confirmed { border-left: 2px solid var(--accent); }
  .card.status-likely { border-left: 2px solid var(--sep); }
  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .card-head h3 {
    margin: 0;
    font-size: 20px;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.2;
  }
  .badge {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 7px;
    border: 1px solid var(--hairline);
    white-space: nowrap;
  }
  .badge.s-confirmed { color: var(--accent); border-color: var(--accent-bd); }
  .badge.s-likely { color: var(--faint); }
  .source {
    margin: 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  .proves {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--dim);
    text-wrap: pretty;
  }
  .path {
    margin: 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    line-height: 1.5;
    color: var(--body);
    background: var(--soft);
    border: 1px solid var(--hairline2);
    padding: 8px 10px;
    word-break: break-all;
  }
  .path-label {
    color: var(--faint);
    letter-spacing: 0.1em;
    margin-right: 8px;
  }

  /* fields */
  .fields { display: flex; flex-direction: column; gap: 6px; }
  .field {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 12px;
    align-items: baseline;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--hairline2);
  }
  .field:last-child { border-bottom: none; padding-bottom: 0; }
  .f-k {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: var(--ink);
    font-weight: 600;
  }
  .f-v {
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* parsers */
  .parsers { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .p-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9.5px;
    letter-spacing: 0.1em;
    color: var(--faint);
    margin-right: 2px;
  }
  .parser {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10.5px;
    color: var(--dim);
    background: var(--soft);
    border: 1px solid var(--hairline);
    padding: 3px 8px;
  }

  /* seen-in receipts */
  .seen {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 4px;
    margin-top: auto;
    border-top: 1px solid var(--hairline2);
  }
  .seen-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9.5px;
    letter-spacing: 0.1em;
    color: var(--faint);
    padding-top: 10px;
  }
  .seen-list { display: flex; flex-wrap: wrap; gap: 6px; }
  .receipt {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: var(--body);
    background: var(--soft);
    border: 1px solid var(--hairline);
    padding: 4px 9px;
    text-decoration: none;
  }
  a.receipt:hover { border-color: var(--accent-bd); color: var(--accent); }
  .receipt.no-link { color: var(--muted); border-style: dashed; cursor: default; }
  .receipt .diff { font-weight: 600; letter-spacing: 0.04em; }
  .d-hard { color: var(--hard); }
