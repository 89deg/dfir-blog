---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

type Diff = 'easy' | 'medium' | 'hard' | 'lab' | 'in progress';
type Platform = 'THM' | 'CD' | 'own lab';

// Single source of truth: the same challenge receipts the Toolbox slices by
// tool. Here they're flattened into one running list. A challenge solved with
// several tools shows up once, with every tool it touched.
const toolsRaw = await getCollection('tools');

type Row = {
  date: string;          // ISO YYYY-MM — used for sorting
  name: string;
  platform: Platform;
  difficulty: Diff;
  url?: string;
  tools: Set<string>;
};

const byChallenge = new Map<string, Row>();
for (const t of toolsRaw) {
  for (const c of t.data.challenges) {
    const key = `${c.name}|${c.platform}`;
    const existing = byChallenge.get(key);
    if (existing) {
      existing.tools.add(t.data.name);
      // keep the earliest recorded date if they ever diverge
      if (c.date < existing.date) existing.date = c.date;
    } else {
      byChallenge.set(key, {
        date: c.date,
        name: c.name,
        platform: c.platform,
        difficulty: c.difficulty,
        url: c.url,
        tools: new Set([t.data.name])
      });
    }
  }
}

// Newest first. Within the same month, alphabetical by challenge name —
// month granularity can't order same-month solves, so we fix a stable rule.
const rows = Array.from(byChallenge.values()).sort(
  (a, b) => b.date.localeCompare(a.date) || a.name.localeCompare(b.name)
);

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
                'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
function monthLabel(iso: string): string {
  const [y, m] = iso.split('-');
  return `${MONTHS[parseInt(m, 10) - 1]} ${y}`;
}

const providerName: Record<Platform, string> = {
  THM: 'TryHackMe',
  CD: 'CyberDefenders',
  'own lab': 'own lab'
};
function diffClass(d: Diff): string {
  if (d === 'hard') return 'd-hard';
  if (d === 'easy') return 'd-easy';
  return 'd-med'; // medium, lab, in progress
}
function diffLabel(d: Diff): string {
  return d === 'in progress' ? 'wip' : d;
}

// Stats over the full log.
const total = rows.length;
const hard = rows.filter(r => r.difficulty === 'hard').length;
const toolsExercised = new Set(rows.flatMap(r => Array.from(r.tools))).size;
const platforms = new Set(rows.map(r => r.platform)).size;
const stats = [
  { n: total,          label: 'CHALLENGES' },
  { n: hard,           label: 'RATED HARD' },
  { n: toolsExercised, label: 'TOOLS EXERCISED' },
  { n: platforms,      label: 'PLATFORMS' }
];

// Difficulty filters — only offer ones that have rows behind them.
const DIFF_ORDER: Diff[] = ['hard', 'medium', 'easy'];
const usedDiffs = new Set(rows.map(r => r.difficulty));
const FILTERS = [
  { id: 'all', label: 'ALL', count: total },
  ...DIFF_ORDER.filter(d => usedDiffs.has(d)).map(d => ({
    id: d,
    label: d.toUpperCase(),
    count: rows.filter(r => r.difficulty === d).length
  }))
];
---
<BaseLayout title="CTF Log — dfir.89deg.com">

  <section class="page-head container">
    <p class="kicker">// CTF LOG — CHRONOLOGICAL</p>
    <h1>Every flag, in the order I caught it.</h1>
    <p class="lede">The Toolbox slices this by tool. This is the plain running list — newest first, each row linked to the platform. One row, one solved challenge.</p>

    <div data-mq="stats" class="stats">
      {stats.map(s => (
        <div class="stat">
          <span class="stat-n">{s.n}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="container filter-section" data-filter-root>
    <div class="filter-bar">
      {FILTERS.map(f => (
        <button
          type="button"
          class="filter-chip"
          data-filter-diff={f.id}
          aria-pressed={f.id === 'all' ? 'true' : 'false'}
        >{f.label} <span class="chip-count">({f.count})</span></button>
      ))}
    </div>
  </section>

  <section class="container log-section">
    <div class="log">
      {rows.map(r => (
        <a
          href={r.url ?? '#'}
          target="_blank"
          rel="noopener"
          class="row"
          data-diff={r.difficulty}
        >
          <span class="r-date">{monthLabel(r.date)}</span>
          <span class="r-name">{r.name}</span>
          <span class="r-provider">{providerName[r.platform]}</span>
          <span class="r-tool">{Array.from(r.tools).join(' · ')}</span>
          <span class={`r-diff ${diffClass(r.difficulty)}`}>{diffLabel(r.difficulty)}</span>
        </a>
      ))}
    </div>
    <p class="tail">Difficulty as rated by the platform, not by me. Rows link straight to the room or challenge — verify any of them.</p>
  </section>

</BaseLayout>

<style>
  .page-head { padding-top: 72px; }
  h1 {
    margin: 0;
    font-size: clamp(34px, 7.5vw, 56px);
    line-height: 1.08;
    font-weight: 500;
    letter-spacing: -0.015em;
    max-width: 18ch;
    text-wrap: balance;
  }
  .lede {
    margin: 22px 0 0 0;
    font-size: 20px;
    line-height: 1.55;
    color: var(--dim);
    font-style: italic;
    max-width: 58ch;
    text-wrap: pretty;
  }

  /* stats */
  .stats {
    margin-top: 40px;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--hairline);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .stat {
    padding: 22px 24px 22px 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
    border-right: 1px solid var(--hairline);
  }
  .stat-n {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 32px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1;
  }
  .stat-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: var(--faint);
  }

  /* filters */
  .filter-section { padding-top: 36px; }
  .filter-bar { display: flex; flex-wrap: wrap; gap: 8px; }
  .filter-chip {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    background: transparent;
    color: var(--muted);
    border: 1px solid var(--hairline);
    padding: 6px 13px;
    cursor: pointer;
  }
  .filter-chip:hover { border-color: var(--accent-bd); color: var(--accent); }
  .filter-chip[aria-pressed='true'] {
    background: var(--soft);
    color: var(--accent);
    border-color: var(--accent);
  }
  .chip-count { opacity: 0.6; }

  /* log table */
  .log-section { padding-top: 24px; padding-bottom: 84px; }
  .log {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--ink);
  }
  .row {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) 148px 128px 88px;
    gap: 24px;
    align-items: baseline;
    padding: 17px 4px;
    border-bottom: 1px solid var(--hairline2);
    text-decoration: none;
    color: inherit;
  }
  .row:hover { background: var(--hover); }
  .r-date {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12.5px;
    color: var(--faint);
    white-space: nowrap;
  }
  .r-name {
    font-size: 19px;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.25;
  }
  .r-provider {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--muted);
  }
  .r-tool {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--dim);
  }
  .r-diff {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: right;
  }
  .d-hard { color: var(--hard); }
  .d-med  { color: var(--med); }
  .d-easy { color: var(--easy); }

  .tail {
    margin: 26px 0 0 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    line-height: 1.7;
    color: var(--faint);
    max-width: 60ch;
  }

  @media (max-width: 760px) {
    .stats { grid-template-columns: 1fr 1fr; }
    .row {
      grid-template-columns: auto 1fr;
      gap: 4px 14px;
    }
    .r-name { grid-column: 1 / -1; order: -1; }
    .r-provider { grid-column: 2; }
    .r-diff { text-align: left; }
  }
</style>

<script>
  const root = document.querySelector('[data-filter-root]');
  const chips = root?.querySelectorAll<HTMLButtonElement>('[data-filter-diff]') ?? [];
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.row'));

  function applyFilter(diff: string) {
    for (const row of rows) {
      const show = diff === 'all' || row.dataset.diff === diff;
      row.style.display = show ? '' : 'none';
    }
    for (const chip of chips) {
      chip.setAttribute('aria-pressed', chip.dataset.filterDiff === diff ? 'true' : 'false');
    }
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => applyFilter(chip.dataset.filterDiff!));
  }
</script>
