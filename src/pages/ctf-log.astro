---
import BaseLayout from '../layouts/BaseLayout.astro';

type Diff = 'easy' | 'medium' | 'hard';
type Platform = 'THM' | 'CD';

type LogEntry = {
  // Sort key. Full 'YYYY-MM-DD' where I have the exact completion date
  // (CyberDefenders shows it), or 'YYYY-MM' where I only know the month.
  // A month-only key sorts *before* any dated day in the same month, so the
  // TryHackMe rooms cluster at the bottom of July — the foundation I did first.
  date: string;
  // Tiebreaker for entries that share a date. Higher = later / newer.
  // Used to keep the TryHackMe learning path in the order I actually walked it.
  seq?: number;
  name: string;
  platform: Platform;
  difficulty: Diff;
  tools?: string[];   // linked tools this challenge exercised
  topic?: string;     // shown instead of a tool for rooms that map to none
  url?: string;       // omitted for rooms with no receipt to link
  wip?: boolean;      // still in progress
  progress?: string;  // e.g. '7/22' flags
  // difficulty not yet verified against the platform (my best guess)
  unverified?: boolean;
};

// ── The log. Single source of truth for this page. ────────────────────────
// TryHackMe rooms were all July 2026 (quick foundation run) — kept in the
// order I did them via `seq`. CyberDefenders dates are the real completion
// dates off my profile. Recruiter — Hanoi Op is still open (7/22).
const LOG: LogEntry[] = [
  // ── currently working on ──
  { date: '2026-08', name: 'Recruiter — Hanoi Op', platform: 'CD', difficulty: 'hard', topic: 'endpoint', wip: true, progress: '7/22' },

  // ── CyberDefenders (real completion dates) ──
  { date: '2026-07-29', name: 'SpottedInTheWild', platform: 'CD', difficulty: 'hard',   tools: ['KAPE', 'Eric Zimmerman Tools'], url: 'https://cyberdefenders.org/blueteam-ctf-challenges/achievements/nils.hillmann/spottedinthewild/' },
  { date: '2026-07-17', name: 'NintendoHunt',     platform: 'CD', difficulty: 'hard',   tools: ['Volatility'], url: 'https://cyberdefenders.org/blueteam-ctf-challenges/achievements/nils.hillmann/nintendohunt/' },
  { date: '2026-07-13', name: 'BlackEnergy',      platform: 'CD', difficulty: 'medium', tools: ['Volatility'], url: 'https://cyberdefenders.org/blueteam-ctf-challenges/achievements/nils.hillmann/blackenergy/' },
  { date: '2026-07-13', name: 'Brave',            platform: 'CD', difficulty: 'medium', tools: ['Volatility'], url: 'https://cyberdefenders.org/blueteam-ctf-challenges/achievements/nils.hillmann/brave/' },
  { date: '2026-07-10', name: 'LGDroid',          platform: 'CD', difficulty: 'medium', tools: ['SQLite / DB Browser'], url: 'https://cyberdefenders.org/blueteam-ctf-challenges/achievements/nils.hillmann/lgdroid/' },
  { date: '2026-07-09', name: 'AndroidBreach',    platform: 'CD', difficulty: 'medium', tools: ['ALEAPP', 'JADX', 'SQLite / DB Browser'], url: 'https://cyberdefenders.org/blueteam-ctf-challenges/achievements/nils.hillmann/androidbreach/' },
  { date: '2026-07-03', name: 'The Crime',        platform: 'CD', difficulty: 'easy',   tools: ['ALEAPP', 'SQLite / DB Browser'], url: 'https://cyberdefenders.org/blueteam-ctf-challenges/achievements/nils.hillmann/the-crime/' },
  { date: '2026-06-16', name: 'Insider',          platform: 'CD', difficulty: 'easy',   tools: ['FTK Imager'], url: 'https://cyberdefenders.org/blueteam-ctf-challenges/achievements/nils.hillmann/insider/' },
  { date: '2026-06-11', name: 'HawkEye',          platform: 'CD', difficulty: 'medium', tools: ['Wireshark'], url: 'https://cyberdefenders.org/blueteam-ctf-challenges/achievements/nils.hillmann/hawkeye/' },

  // ── TryHackMe (all July 2026, in the order I did them) ──
  { date: '2026-07', seq: 17, name: 'Hashing — Crypto 101',          platform: 'THM', difficulty: 'easy',   topic: 'crypto',   unverified: true },
  { date: '2026-07', seq: 16, name: 'Encryption — Crypto 101',       platform: 'THM', difficulty: 'medium', topic: 'crypto',   unverified: true },
  { date: '2026-07', seq: 15, name: 'iOS Forensics',                 platform: 'THM', difficulty: 'medium', topic: 'iOS',      unverified: true },
  { date: '2026-07', seq: 14, name: 'Android Analysis',              platform: 'THM', difficulty: 'easy',   tools: ['ALEAPP'], url: 'https://tryhackme.com/room/androidanalysis' },
  { date: '2026-07', seq: 13, name: 'Intro to Malware Analysis',     platform: 'THM', difficulty: 'easy',   topic: 'malware',  unverified: true },
  { date: '2026-07', seq: 12, name: 'Wireshark: Traffic Analysis',   platform: 'THM', difficulty: 'medium', tools: ['Wireshark'], url: 'https://tryhackme.com/guest-share/621b07bd5514ea80ec3b5d17e436a33341133315' },
  { date: '2026-07', seq: 11, name: 'Wireshark: Packet Operations',  platform: 'THM', difficulty: 'easy',   tools: ['Wireshark'], url: 'https://tryhackme.com/room/wiresharkpacketoperations' },
  { date: '2026-07', seq: 10, name: 'Wireshark: The Basics',         platform: 'THM', difficulty: 'easy',   tools: ['Wireshark'], url: 'https://tryhackme.com/room/wiresharkthebasics' },
  { date: '2026-07', seq: 9,  name: 'Memory Forensics',              platform: 'THM', difficulty: 'easy',   tools: ['Volatility'], url: 'https://tryhackme.com/room/memoryforensics' },
  { date: '2026-07', seq: 8,  name: 'Volatility',                    platform: 'THM', difficulty: 'medium', tools: ['Volatility'], url: 'https://tryhackme.com/guest-share/f112c681f00289fda4559ef93638e723b56de0ef' },
  { date: '2026-07', seq: 7,  name: 'Linux Forensics',               platform: 'THM', difficulty: 'medium', topic: 'Linux',    unverified: true },
  { date: '2026-07', seq: 6,  name: 'KAPE',                          platform: 'THM', difficulty: 'medium', tools: ['KAPE'], url: 'https://tryhackme.com/room/kape' },
  { date: '2026-07', seq: 5,  name: 'Windows Forensics 2',           platform: 'THM', difficulty: 'medium', tools: ['Eric Zimmerman Tools'], url: 'https://tryhackme.com/room/windowsforensics2' },
  { date: '2026-07', seq: 4,  name: 'Windows Forensics 1',           platform: 'THM', difficulty: 'medium', tools: ['Eric Zimmerman Tools'], url: 'https://tryhackme.com/room/windowsforensics1' },
  { date: '2026-07', seq: 3,  name: 'Disk Analysis & Autopsy',       platform: 'THM', difficulty: 'medium', tools: ['Autopsy'], url: 'https://tryhackme.com/room/autopsy2ze0' },
  { date: '2026-07', seq: 2,  name: 'Autopsy',                       platform: 'THM', difficulty: 'easy',   tools: ['Autopsy'], url: 'https://tryhackme.com/room/btautopsye0' },
  { date: '2026-07', seq: 1,  name: 'Digital Forensics Fundamentals',platform: 'THM', difficulty: 'easy',   topic: 'intro',    unverified: true }
];

// Newest first. Same date → higher seq first, then name.
const rows = [...LOG].sort((a, b) =>
  b.date.localeCompare(a.date) || (b.seq ?? 0) - (a.seq ?? 0) || a.name.localeCompare(b.name)
);

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
                'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
function monthLabel(date: string): string {
  const [y, m] = date.split('-');
  return `${MONTHS[parseInt(m, 10) - 1]} ${y}`;
}

const providerName: Record<Platform, string> = {
  THM: 'TryHackMe',
  CD: 'CyberDefenders'
};
function diffClass(d: Diff): string {
  return d === 'hard' ? 'd-hard' : d === 'easy' ? 'd-easy' : 'd-med';
}
function toolCell(r: LogEntry): string {
  return r.tools?.join(' · ') ?? r.topic ?? '—';
}

// Stats over completed challenges (the in-progress one doesn't count as solved).
const done = LOG.filter(r => !r.wip);
const hard = done.filter(r => r.difficulty === 'hard').length;
const toolsExercised = new Set(LOG.flatMap(r => r.tools ?? [])).size;
const platforms = new Set(LOG.map(r => r.platform)).size;
const stats = [
  { n: done.length,     label: 'SOLVED' },
  { n: hard,            label: 'RATED HARD' },
  { n: toolsExercised, label: 'TOOLS EXERCISED' },
  { n: platforms,      label: 'PLATFORMS' }
];

// Difficulty filters — only offer ones with rows behind them.
const DIFF_ORDER: Diff[] = ['hard', 'medium', 'easy'];
const usedDiffs = new Set(rows.map(r => r.difficulty));
const FILTERS = [
  { id: 'all', label: 'ALL', count: rows.length },
  ...DIFF_ORDER.filter(d => usedDiffs.has(d)).map(d => ({
    id: d,
    label: d.toUpperCase(),
    count: rows.filter(r => r.difficulty === d).length
  }))
];
---
<BaseLayout title="CTF Log — dfir.89deg.com">

  <section class="page-head container">
    <p class="kicker">// CTF LOG — CHRONOLOGICAL</p>
    <h1>Every flag, in the order I caught it.</h1>
    <p class="lede">The Toolbox slices this by tool. This is the plain running list — newest first, each mapped tool linked to its receipt. One row, one challenge.</p>

    <div class="stats">
      {stats.map(s => (
        <div class="stat">
          <span class="stat-n">{s.n}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="container filter-section" data-filter-root>
    <div class="filter-bar">
      {FILTERS.map(f => (
        <button
          type="button"
          class="filter-chip"
          data-filter-diff={f.id}
          aria-pressed={f.id === 'all' ? 'true' : 'false'}
        >{f.label} <span class="chip-count">({f.count})</span></button>
      ))}
    </div>
  </section>

  <section class="container log-section">
    <div class="log">
      {rows.map(r => {
        const cls = `row${r.wip ? ' row-wip' : ''}`;
        const inner = (
          <>
            <span class="r-date">{monthLabel(r.date)}</span>
            <span class="r-name">
              {r.name}
              {r.wip && <span class="wip-tag">IN PROGRESS · {r.progress}</span>}
            </span>
            <span class="r-provider">{providerName[r.platform]}</span>
            <span class="r-tool">{toolCell(r)}</span>
            <span class={`r-diff ${diffClass(r.difficulty)}`}>{r.difficulty}</span>
          </>
        );
        return r.url ? (
          <a href={r.url} target="_blank" rel="noopener" class={cls} data-diff={r.difficulty}>{inner}</a>
        ) : (
          <div class={cls} data-diff={r.difficulty}>{inner}</div>
        );
      })}
    </div>
    <p class="tail">Difficulty as rated by the platform, not by me. Rows that map to a tool link straight to the room or challenge — verify any of them. Rooms with no linked receipt were still done; they just don't hang off a single tool.</p>
  </section>

</BaseLayout>

<style>
  .page-head { padding-top: 72px; }
  h1 {
    margin: 0;
    font-size: clamp(34px, 7.5vw, 56px);
    line-height: 1.08;
    font-weight: 500;
    letter-spacing: -0.015em;
    max-width: 18ch;
    text-wrap: balance;
  }
  .lede {
    margin: 22px 0 0 0;
    font-size: 20px;
    line-height: 1.55;
    color: var(--dim);
    font-style: italic;
    max-width: 58ch;
    text-wrap: pretty;
  }

  /* stats */
  .stats {
    margin-top: 40px;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--hairline);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .stat {
    padding: 22px 24px 22px 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
    border-right: 1px solid var(--hairline);
  }
  .stat-n {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 32px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1;
  }
  .stat-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: var(--faint);
  }

  /* filters */
  .filter-section { padding-top: 36px; }
  .filter-bar { display: flex; flex-wrap: wrap; gap: 8px; }
  .filter-chip {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    background: transparent;
    color: var(--muted);
    border: 1px solid var(--hairline);
    padding: 6px 13px;
    cursor: pointer;
  }
  .filter-chip:hover { border-color: var(--accent-bd); color: var(--accent); }
  .filter-chip[aria-pressed='true'] {
    background: var(--soft);
    color: var(--accent);
    border-color: var(--accent);
  }
  .chip-count { opacity: 0.6; }

  /* log table */
  .log-section { padding-top: 24px; padding-bottom: 84px; }
  .log {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--ink);
  }
  .row {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) 148px 128px 88px;
    gap: 24px;
    align-items: baseline;
    padding: 17px 4px;
    border-bottom: 1px solid var(--hairline2);
    text-decoration: none;
    color: inherit;
  }
  a.row:hover { background: var(--hover); }
  .row-wip { background: var(--soft); }
  .r-date {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12.5px;
    color: var(--faint);
    white-space: nowrap;
  }
  .r-name {
    font-size: 19px;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.25;
  }
  .wip-tag {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--accent);
    border: 1px solid var(--accent-bd);
    padding: 2px 6px;
    margin-left: 10px;
    white-space: nowrap;
  }
  .r-provider {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--muted);
  }
  .r-tool {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--dim);
  }
  .r-diff {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: right;
  }
  .d-hard { color: var(--hard); }
  .d-med  { color: var(--med); }
  .d-easy { color: var(--easy); }

  .tail {
    margin: 26px 0 0 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    line-height: 1.7;
    color: var(--faint);
    max-width: 64ch;
  }

  @media (max-width: 760px) {
    .stats { grid-template-columns: 1fr 1fr; }
    .row {
      grid-template-columns: auto 1fr;
      gap: 4px 14px;
    }
    .r-name { grid-column: 1 / -1; order: -1; }
    .r-provider { grid-column: 2; }
    .r-diff { text-align: left; }
  }
</style>

<script>
  const root = document.querySelector('[data-filter-root]');
  const chips = root?.querySelectorAll<HTMLButtonElement>('[data-filter-diff]') ?? [];
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.row'));

  function applyFilter(diff: string) {
    for (const row of rows) {
      const show = diff === 'all' || row.dataset.diff === diff;
      row.style.display = show ? '' : 'none';
    }
    for (const chip of chips) {
      chip.setAttribute('aria-pressed', chip.dataset.filterDiff === diff ? 'true' : 'false');
    }
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => applyFilter(chip.dataset.filterDiff!));
  }
</script>
